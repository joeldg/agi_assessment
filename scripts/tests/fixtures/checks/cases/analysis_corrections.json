{
 "rule": "#corrections lists every correction",
 "ops": [
  {
   "file": "data/runs.json",
   "set": [
    -1,
    "corrections"
   ],
   "value": [
    {
     "date": "2026-10-06",
     "page": "reports/2026-10-05.html",
     "was": "x",
     "now": "y"
    },
    {
     "date": "2026-10-06",
     "page": "reports/2026-10-05.html",
     "was": "x",
     "now": "y"
    }
   ]
  },
  {
   "file": "reports/2026-10-06-analysis.html",
   "replace": [
    "<!-- analysis:end -->",
    "<!-- analysis:end -->\n<section id=\"corrections\"><h2>Corrections in this reading</h2><ul class=\"plain\"><li>Correction.</li></ul></section>"
   ]
  }
 ],
 "expect": "#corrections lists 1 of the run's 2 corrections"
}
